{
  "format": "mas-workflow/1",
  "limits": {
    "max_calls": 20,
    "max_parallel": 2,
    "max_reserved_microusd": 0,
    "max_steps": 64,
    "wall_seconds": 180
  },
  "name": "arithmetic-evidence",
  "root": {
    "kind": "sequence",
    "steps": [
      {
        "kind": "subworkflow",
        "workflow": "bounded-increment"
      },
      {
        "branches": {
          "double": {
            "kind": "task",
            "workflow": "arithmetic-double"
          },
          "square": {
            "kind": "task",
            "workflow": "arithmetic-square"
          }
        },
        "kind": "parallel"
      }
    ]
  },
  "version": "1"
}
