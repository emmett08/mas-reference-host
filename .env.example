# The default Compose run is mock-only. Keep API keys out of this file.
# Live overrides mount provider-specific secrets from the host environment.
# OpenAI defaults are gpt-4.1-mini and gpt-4o-mini; uncomment to change them.
# MAS_PLANNER_MODEL=gpt-4.1-mini
# MAS_REVIEWER_MODEL=gpt-4o-mini
#
# compose.cursor.yaml requires both models to be explicitly selected from your
# Cursor account's catalogue. compose.mixed.yaml requires a Cursor planner model
# and uses an OpenAI reviewer (gpt-4o-mini by default).
# MAS_PLANNER_MODEL=<your Cursor model identifier>
# MAS_REVIEWER_MODEL=<your Cursor model identifier>
# Native --mode mixed also requires MAS_PLANNER_PROVIDER and
# MAS_REVIEWER_PROVIDER, each selected from mock, openai or cursor.
# For an environment requiring an HTTP proxy, select the supported Cursor
# HTTP/1.1 transport. Supply proxy and trusted CA settings in the runtime.
# MAS_CURSOR_TRANSPORT=environment-proxy-http1

# Admission allowance per paid call, in microUSD; not an actual billing estimate.
MAS_CALL_RESERVATION_MICROUSD=100000
# Optional per-role overrides (positive for live providers; mock always uses 0).
# MAS_PLANNER_RESERVATION_MICROUSD=100000
# MAS_REVIEWER_RESERVATION_MICROUSD=100000
